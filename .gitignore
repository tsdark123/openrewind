# ==============================================================================
# OpenReplay .gitignore
# ==============================================================================

# --- CSV Data Cache (downloaded market data) ---
data/*
!data/.gitkeep

# --- C++ Build Artifacts ---
engine/build/
engine/out/
*.obj
*.o
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# --- vcpkg ---
vcpkg_installed/

# --- Visual Studio ---
.vs/
*.suo
*.user
*.sln.docstates
x64/
x86/
Debug/
Release/

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Python ---
__pycache__/
*.pyc
.env

# --- Tauri / Rust ---
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/*.exe
src-tauri/binaries/openreplay-engine-*
!src-tauri/binaries/.gitkeep

# --- Root node_modules (Tauri CLI) ---
node_modules/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
