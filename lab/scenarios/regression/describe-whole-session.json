{
  "id": "describe-whole-session",
  "name": "Describe what happened today",
  "description": "User asks 'Describe what happened today' with an active session. The agent must summarize the current session, not resolve or switch a symbol.",
  "version": "2.0.0",
  "familyId": "window-summary",
  "seedId": "describe-whole-session",
  "tags": ["regression", "window-summary", "whole-session"],
  "dataSet": { "symbol": "SYNTH", "date": "2026-08-05", "timeframe": 1 },
  "initialWorldState": {
    "session": {
      "symbol": "SYNTH",
      "date": "2026-08-05",
      "timeframe": 1,
      "cursor": 389,
      "totalCandles": 390,
      "isPlaying": false,
      "speed": 1,
      "direction": "forward",
      "currentPrice": 103.89,
      "sessionActive": true
    },
    "availableTickers": ["SYNTH"],
    "recentCandles": [],
    "groundTruth": { "source": "fixture", "fixture": "synthetic-session-1m" }
  },
  "exactInvariants": { "symbol": "SYNTH", "date": "2026-08-05", "timeframe": 1 },
  "permittedActions": ["analysis.*"],
  "forbiddenActions": ["session.resolve_symbol", "session.switch_symbol", "session.switch_to_previous_symbol"],
  "latencyLimits": { "maxMsPerTurn": 5000 },
  "turns": [
    {
      "id": "t1",
      "utterance": "Describe what happened today.",
      "expectedRoute": "deterministic",
      "assertExactRoute": false,
      "expectedCapabilities": ["analysis.window_summary"],
      "exactInvariants": {
        "symbol": "SYNTH",
        "date": "2026-08-05",
        "timeframe": 1,
        "window": { "kind": "whole_session" }
      },
      "expectedContextAfter": {
        "kind": "chart_action",
        "symbol": "SYNTH",
        "date": { "kind": "absolute", "value": "2026-08-05" },
        "timeframeMinutes": 1,
        "analysisRequests": [
          { "kind": "window_summary", "window": { "kind": "whole_session" } }
        ]
      },
      "numericalTruthChecks": [
        {
          "receiptCapability": "analysis.window_summary",
          "computed": {
            "capability": "analysis.window_summary",
            "window": { "kind": "whole_session" }
          },
          "tolerance": { "absolute": 0.01, "relative": 0.001 }
        }
      ],
      "consumerResponseExpectations": {
        "mustContain": ["SYNTH", "session"],
        "forbiddenTopics": ["switch", "resolve"]
      }
    }
  ]
}
