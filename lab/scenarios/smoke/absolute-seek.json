{
  "id": "absolute-seek",
  "name": "Absolute seek",
  "description": "User asks to jump to an absolute market time. The agent must produce a chart-action template with seekTime set to the requested time.",
  "version": "2.0.0",
  "familyId": "playback",
  "seedId": "absolute-seek",
  "tags": ["smoke", "playback", "seek"],
  "dataSet": { "symbol": "SYNTH", "date": "2026-08-05", "timeframe": 1 },
  "initialWorldState": {
    "session": {
      "symbol": "SYNTH",
      "date": "2026-08-05",
      "timeframe": 1,
      "cursor": 0,
      "totalCandles": 390,
      "isPlaying": false,
      "speed": 1,
      "direction": "forward",
      "currentPrice": 100,
      "sessionActive": true
    },
    "availableTickers": ["SYNTH"],
    "recentCandles": [],
    "groundTruth": { "source": "fixture", "fixture": "synthetic-session-1m" }
  },
  "exactInvariants": { "symbol": "SYNTH", "date": "2026-08-05", "timeframe": 1 },
  "permittedActions": ["playback.*"],
  "forbiddenActions": ["analysis.*", "session.*"],
  "latencyLimits": { "maxMsPerTurn": 5000 },
  "turns": [
    {
      "id": "t1",
      "utterance": "Jump to 11:30.",
      "expectedRoute": "deterministic",
      "assertExactRoute": false,
      "expectedCapabilities": ["playback.seek_to_time"],
      "exactInvariants": { "symbol": "SYNTH", "date": "2026-08-05", "timeframe": 1, "seekTime": "11:30" },
      "expectedContextAfter": {
        "kind": "chart_action",
        "symbol": "SYNTH",
        "date": { "kind": "absolute", "value": "2026-08-05" },
        "timeframeMinutes": 1,
        "seekTime": "11:30"
      },
      "expectedReceipts": [
        { "capability": "playback.seek_to_time", "success": true, "dataShape": { "time": true, "cursor": true } }
      ],
      "expectedFinalWorldState": {
        "symbol": "SYNTH",
        "date": "2026-08-05",
        "timeframe": 1,
        "cursor": 60,
        "totalCandles": 390,
        "sessionActive": true
      },
      "consumerResponseExpectations": {
        "mustContain": ["11:30"]
      }
    }
  ]
}
